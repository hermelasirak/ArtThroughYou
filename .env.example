# Gemini powers personalised chapters and adaptive reflection questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Cloudflare Workers AI powers artwork and identity-guided timeline images.
# Create a Workers AI API token and copy your Cloudflare Account ID from the dashboard.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Supabase configuration (remote persistence is not wired in this MVP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
